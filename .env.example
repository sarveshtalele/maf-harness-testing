# Copy to .env or export in your shell. The harness never stores or forwards these.
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://your-openai-compatible-gateway   # optional
OPENAI_MODEL=deepseek-v4-flash-global                     # any tool-capable chat model

# Optional tuning (defaults shown). The only spending limit is a daily cap of 5,000,000 tokens across all runs.
# HARNESS_USAGE_DIR=~/.maf-harness/usage   # where the daily token ledger is kept
# HARNESS_SKILL_MODE=progressive        # or "preloaded" for models that cannot call tools
# HARNESS_GENERATION_BATCH_SIZE=3
# HARNESS_GENERATION_MAX_ATTEMPTS=3
# HARNESS_MAX_OUTPUT_TOKENS=16384
# HARNESS_EXECUTION_TIMEOUT=900
# HARNESS_DAILY_TOKEN_LIMIT=5000000   # the machine owner may raise the daily cap; there is no other limit
# HARNESS_AGENT_TOOLS=on              # central deterministic tools callable by agents (off = A/B baseline)
# HARNESS_AUTOFIX=on                  # mechanical import repairs before any model retry
# HARNESS_BUILD_GATE=on               # pytest --collect-only / mvn test-compile on candidates after env install
