# Copy to .env in the project root (git-ignored; read automatically) or export these in your shell.
# A variable already set in the shell wins over .env. Restart the app after editing.
# The harness never stores these in a run directory and never forwards them to the commands it executes.

# Your gateway's key (required).
OPENAI_API_KEY=replace-with-your-key
# The root URL of your OpenAI-compatible gateway (omit for api.openai.com). Some gateways need a /v1 suffix.
OPENAI_BASE_URL=https://your-openai-compatible-gateway
# The model name as your gateway knows it; must support tool calling. LLM_MODEL is accepted as an alias.
OPENAI_MODEL=deepseek-v4-flash-global

# Optional tuning (defaults shown). The only spending limit is a daily cap of 50,000,000 tokens across all runs.
# HARNESS_USAGE_DIR=~/.maf-harness/usage   # where the daily token ledger is kept
# HARNESS_SKILL_MODE=progressive        # or "preloaded" for models that cannot call tools
# HARNESS_GENERATION_BATCH_SIZE=3
# HARNESS_GENERATION_MAX_ATTEMPTS=3     # retry budget for generation (synthesis and fixes)
# HARNESS_MAX_FAILED_BATCH_RATIO=0.5    # fail-soft: generation succeeds if <50% of batches fail; 0.0-1.0
# HARNESS_TEST_REVIEW_MIN_CONFIDENCE=80  # a generated case is accepted only if supported with host confidence >= this (50-100)
# HARNESS_REQUIRE_FULL_ACCURACY=1      # 0 allows execution with unverified cases (fail-soft); 1 blocks until every case is verified
# HARNESS_ACCURACY_ROUNDS=2            # targeted regeneration rounds for unverified cases before the accuracy gate blocks (0-5)
# HARNESS_STAGE_MODELS='{"requirements":"<smaller-model>","test_planning":"<smaller-model>"}'  # per-stage overrides; unset stages use OPENAI_MODEL
# HARNESS_MAX_OUTPUT_TOKENS=16384
# HARNESS_EXECUTION_TIMEOUT=900
# HARNESS_MODEL_TIMEOUT_SECONDS=300  # maximum duration of one model operation; exposes a retry gate on timeout
# HARNESS_RUNS_DIR=...               # optional run storage override; default <repo-root>/.maf-harness/runs
# HARNESS_LOG_DIR=...                # launcher/setup/service logs (default <repo-root>/.maf-harness/logs)
# HARNESS_DAILY_TOKEN_LIMIT=50000000  # the machine owner may raise the daily cap; there is no other limit
# HARNESS_AGENT_TOOLS=on              # central deterministic tools callable by agents (off = A/B baseline)
# HARNESS_AUTOFIX=on                  # mechanical import repairs before any model retry
# HARNESS_STRICT_ENV=on                # on (default): no stage after environment_setup starts until every declared requirement is installed and consistent
# HARNESS_HOOKS=enforce               # enforce | evaluate_only (record, never block) | off; see docs/HOOKS.md
# HARNESS_HOOKS_BACKEND=inhouse        # or sdk (needs: pip install maf-test-harness[hooks])
# HARNESS_DIAGNOSIS_AGENT=off         # on: an LLM note after setup failures the harness could not recover (docs/AUTOMATION.md)
# HARNESS_SKILL_EVALUATORS=off        # on: reviewed skill validators as a design-stage tool
# HARNESS_OTEL=off                    # off | console | otlp: export MAF OpenTelemetry spans (needs opentelemetry-sdk)
# HARNESS_BUILD_GATE=on               # pytest --collect-only / mvn test-compile on candidates after env install
# HARNESS_RESPONSE_CACHE=1             # 0 disables the local cache of validated temperature-0 stage answers (docs/CACHING.md)
# HARNESS_RESPONSE_CACHE_DIR=...       # default <repo-root>/.maf-harness/cache/responses
# HARNESS_CASES_PER_REQUIREMENT=2      # design cases kept per requirement (1-10); a run can override it until design is approved
# HARNESS_DESIGN_REVIEW=1              # 0/off/false/no skips the advisory Chief Architect review of design cases
# HARNESS_DESIGN_REVIEW_MIN_CONFIDENCE=60  # design cases below this host confidence are flagged for review
# HARNESS_TOOLCHAIN_DIR=~/.maf-harness/toolchains  # where downloaded language toolchains are cached
# HARNESS_TOOLCHAIN_MIRROR=...         # offline mirror: every toolchain download and metadata request goes here
# HARNESS_PLUGIN_DIR=...               # user skill plugin folder (default <data dir>/plugins); plugins stay unverified until approved
# HARNESS_PLUGIN_APPROVALS=~/.maf-harness/plugins.lock.json  # where approved plugin hashes are recorded (kept outside target repos)
# HARNESS_DATA_DIR=...                 # per-user data root (default <repo-root>/.maf-harness; per-OS app data in the packaged desktop app)
# HARNESS_MCP_SECRET_<SERVER>_<KEY>=...  # MCP server secret supplied by environment instead of the API (docs/MCP.md)
