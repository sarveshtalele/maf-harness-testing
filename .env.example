# Copy to .env or export in your shell. The harness never stores or forwards these.
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://your-openai-compatible-gateway   # optional
OPENAI_MODEL=deepseek-v4-flash-global                     # any tool-capable chat model

# Optional tuning (defaults shown). The workflow token budget is fixed at 2,000,000 tokens per run.
# HARNESS_SKILL_MODE=progressive        # or "preloaded" for models that cannot call tools
# HARNESS_GENERATION_BATCH_SIZE=3
# HARNESS_GENERATION_MAX_ATTEMPTS=3
# HARNESS_MAX_OUTPUT_TOKENS=16384
# HARNESS_EXECUTION_TIMEOUT=900
