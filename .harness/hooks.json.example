{
  "$comment": "Copy this file to <user data>/.harness/hooks.json (macOS: ~/Library/Application Support/AgenticQE/.harness/, Windows: %APPDATA%\\AgenticQE\\.harness\\, Linux: ~/.local/share/agentic-qe/.harness/; a source checkout: .maf-harness/.harness/ in the repository). ~/.maf-harness/hooks.json is read too. Hooks are never read from the working directory: a checkout can contain hooks. Commands are argv lists; a relative script is resolved beside this file.",
  "mode": "enforce",
  "builtins": {
    "stage_budget": {"per_stage_tokens": 2000000},
    "audit": true
  },
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "^write_test_file$",
      "command": ["python", "hooks/check_path.py"],
      "timeout": 5,
      "name": "no-shell-scripts"
    },
    {
      "event": "StageGate",
      "matcher": "^environment_setup$",
      "python": "my_hooks:change_window"
    },
    {
      "event": "OnExecError",
      "command": ["python", "hooks/notify.py"]
    }
  ]
}
