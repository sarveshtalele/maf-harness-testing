{
  "test_cases": [
    {
      "id": "TC-LOGIN-001",
      "title": "User logs in with valid credentials",
      "type": "UI",
      "story_id": "US-LOGIN-01",
      "linked_requirements": ["REQ-LOGIN-01"],
      "steps": [
        {
          "order": 1,
          "action": "Navigate to login page",
          "target": "https://app.example.test/login",
          "locator": "[data-test=login-form]",
          "expected": "Login form is visible"
        },
        {
          "order": 2,
          "action": "Enter valid email and password",
          "target": "[data-test=email], [data-test=password]",
          "expected": "Credentials are accepted"
        },
        {
          "order": 3,
          "action": "Submit the form",
          "target": "[data-test=login-submit]",
          "expected": "Dashboard heading is visible"
        }
      ],
      "acceptance_criteria": ["A valid user is redirected to the dashboard"],
      "preconditions": ["User account exists"],
      "postconditions": ["User is authenticated"],
      "test_data_refs": ["TC-LOGIN-001_positive_fixtures"]
    },
    {
      "id": "TC-API-LOGIN-001",
      "title": "Login endpoint accepts valid credentials",
      "type": "API",
      "story_id": "US-LOGIN-01",
      "linked_requirements": ["REQ-LOGIN-01"],
      "steps": [{ "order": 1, "action": "Submit valid credentials", "target": "/api/users/login", "expected": "A token is returned" }],
      "acceptance_criteria": ["Valid credentials receive a 200 response"],
      "preconditions": [],
      "postconditions": ["An access token is issued"],
      "test_data_refs": ["TC-API-LOGIN-001_positive_fixtures"]
    }
  ],
  "fixtures": {
    "TC-LOGIN-001_positive_fixtures": {
      "email": "member@example.test",
      "password": "ExamplePass123!"
    },
    "TC-API-LOGIN-001_positive_fixtures": {
      "email": "member@example.test",
      "password": "ExamplePass123!"
    }
  },
  "api_contracts": [{
    "path": "/api/users/login",
    "method": "POST",
    "request_schema": { "type": "object", "required": ["email", "password"] },
    "response_schema": { "type": "object", "properties": { "token": { "type": "string" } } },
    "status_codes": [200]
  }]
}
